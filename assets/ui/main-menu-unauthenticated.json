{
    "id": "main-menu-unauthenticated",
    "meta": {
        "resolution": [1920, 1080],
        "anchor-mode": "relative"
    },

    "elements": [
        {
            "type": "image",
            "id": "background",
            "z_index": 0,
            "position": { "x": 0.5, "y": 0.5, "anchor": "center" },
            "size": { "mode": "fill" },
            "texture": { "sheet": 2, "tile": [0, 0] }
        },

        {
            "type": "button",
            "id": "login-button",
            "z_index": 10,
            "position": { "x": 0.5, "y": 0.4, "anchor": "center" },
            "size": { "width": 400, "height": 100 },

            "states": {
                "normal": { "texture": { "sheet": 5, "tile": [0, 0] } },
                "hovered": { "texture": { "sheet": 5, "tile": [1, 0] } },
                "pressed": { "texture": { "sheet": 5, "tile": [2, 0] } },
                "hidden": { "visible": false }
            },

            "text": {
                "i18n": "main-menu.login-button-label",
                "font": "LuckiestGuy-Regular",
                "size": 60,
                "color": [255, 255, 255]
            },

            "action": "show_login_overlay"
        },

        {
            "type": "form",
            "id": "login-form",
            "z_index": 100,
            "position": { "x": 0.5, "y": 0.5, "anchor": "center" },
            "size": { "width": 960, "height": 540 },
            "texture": { "sheet": 3, "tile": [0, 0] },

            "default-state": "hidden",
            "states": {
                "hidden": { "visible": false },
                "shown": { "visible": true }
            },

            "children": [
                {
                    "type": "textarea",
                    "id": "login-textarea",
                    "z_index": 110,
                    "position": { "x": 0.5, "y": 0.2, "anchor": "center" },
                    "size": { "width": 800, "height": 100 },
                    "texture": { "sheet": 4, "tile": [0, 0] },

                    "label": {
                        "font": "LuckiestGuy-Regular",
                        "size": 32,
                        "color": [255, 255, 255]
                    },

                    "hint": {
                        "i18n": "login-form.login-textarea-hint",
                        "font": "LuckiestGuy-Regular",
                        "size": 32,
                        "color": [255, 255, 255]
                    }
                },

                {
                    "type": "textarea",
                    "id": "password-textarea",
                    "z_index": 110,
                    "position": { "x": 0.5, "y": 0.5, "anchor": "center" },
                    "size": { "width": 800, "height": 100 },
                    "texture": { "sheet": 4, "tile": [0, 0] },

                    "label": {
                        "font": "LuckiestGuy-Regular",
                        "size": 32,
                        "color": [255, 255, 255]
                    },

                    "password_mode": true,

                    "hint": {
                        "i18n": "login-form.password-textarea-hint",
                        "font": "LuckiestGuy-Regular",
                        "size": 32,
                        "color": [0, 0, 0]
                    }
                },

                {
                    "type": "button",
                    "id": "attempt-login",
                    "z_index": 110,
                    "position": { "x": 0.5, "y": 0.75, "anchor": "center" },
                    "size": { "width": 300, "height": 50 },

                    "states": {
                        "normal": { "texture": { "sheet": 5, "tile": [0, 0] } },
                        "hovered": { "texture": { "sheet": 5, "tile": [1, 0] } },
                        "pressed": { "texture": { "sheet": 5, "tile": [2, 0] } },
                        "hidden": { "visible": false }
                    },

                    "text": {
                        "i18n": "login-form.login-button-label",
                        "font": "LuckiestGuy-Regular",
                        "size": 36,
                        "color": [0, 0, 0]
                    },

                    "action": "submit_login_attempt"
                },

                {
                    "type": "text",
                    "id": "stub-error",
                    "z-index": 110,
                    "position": { "x": 0.5, "y": 0.9, "anchor": "center" },
                    "size": { "width": 600, "height": 100 },

                    "default-state": "hidden",
                    "states": {"hidden": { "visible": false }, "shown": { "visible": true }},

                    "text": {
                        "i18n": "login-form.not-everything-filled-error",
                        "font": "LuckiestGuy-Regular",
                        "size": 30,
                        "color": [255, 0, 0]
                    }
                }
            ]
        },

        {
            "type": "button",
            "id": "settings",
            "z_index": 10,
            "position": { "x": 0.01, "y": 0.97, "anchor": "bottom-left" },
            "size": { "mode": "match-texture" },

            "states": {
                "normal": { "texture": { "sheet": 10, "tile": [0, 1] } },
                "hovered": { "texture": { "sheet": 10, "tile": [1, 1] } },
                "pressed": { "texture": { "sheet": 10, "tile": [2, 1] } }
            },
            
            "action": "open_settings"
        },

        {
            "type": "button",
            "id": "exit",
            "z_index": 10,
            "position": { "x": 0.01, "y": 0.01, "anchor": "top-left" },
            "size": { "mode": "match-texture" },

            "states": {
                "normal": { "texture": { "sheet": 10, "tile": [0, 2] } },
                "hovered": { "texture": { "sheet": 10, "tile": [1, 2] } },
                "pressed": { "texture": { "sheet": 10, "tile": [2, 2] } }
            },
            
            "action": "exit"
        }
    ]
}